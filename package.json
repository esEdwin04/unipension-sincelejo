{
  "name": "unipension-sincelejo",
  "version": "0.4.0",
  "description": "Aplicación web para la oferta de pensiones universitarias en Sincelejo, Sucre",
  "main": "backend/server.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "start": "node backend/server.js",
    "dev": "node --watch backend/server.js",
    "dev:client": "npm --prefix client run dev",
    "build": "npm --prefix client install && npm --prefix client run build",
    "test": "node --test pruebas/api.test.js",
    "db:iniciar": "node -e \"require('./backend/db').listo.then(() => process.exit(0), (e) => { console.error(e); process.exit(1); })\""
  },
  "keywords": [],
  "author": "Edwin Díaz, José Paternina, Jesús Villalba",
  "license": "ISC",
  "dependencies": {
    "@libsql/client": "^0.15.15",
    "bcryptjs": "^3.0.3",
    "express": "^5.3.0",
    "express-session": "^1.19.0",
    "pdfkit": "^0.20.2"
  },
  "engines": {
    "node": ">=20"
  }
}
